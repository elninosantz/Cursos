MEMBERKIT_URL=https://aluno.java10x.dev
MEMBERKIT_EMAIL=seu@email.com
MEMBERKIT_PASSWORD=suasenha

ENTREGADIGITAL_URL=https://app.chessflix.com.br
ENTREGADIGITAL_EMAIL=seu@email.com
ENTREGADIGITAL_PASSWORD=suasenha

DIDATI_URL=https://lafabrique.didati.ca
DIDATI_EMAIL=
DIDATI_PASSWORD=

BALTA_EMAIL=
BALTA_PASSWORD=
# Proxy para contornar bloqueio Cloudflare em VPS (ex: 1.2.3.4:3129)
# Se vazio, usa proxy.txt automaticamente se o arquivo existir
BALTA_PROXY=
BALTA_PROXY_FILE=proxy.txt

DESENVOLVEDORIO_EMAIL=
DESENVOLVEDORIO_PASSWORD=

HUBLA_EMAIL=
HUBLA_PASSWORD=

CURSODEV_EMAIL=
CURSODEV_PASSWORD=
# Login = email/senha + código MFA enviado por email (digitado no prompt).
# O Cloudflare do curso.dev desafia o /api de forma agressiva. Ordem de bypass:
#   1) Navegador real (patchright + Chrome) resolve o managed challenge NO SEU
#      IP, clicando no Turnstile. Precisa de display (desktop). Headed por
#      padrão; CURSODEV_HEADLESS=true só com xvfb.
#   2) Capsolver (CAPSOLVER_API_KEY) — precisa de CURSODEV_PROXY, pois o
#      cf_clearance é atrelado ao IP do proxy (ip:porta[:user:senha]).
#   3) Cookies exportados do seu browser logado (fallback manual).
# Obs.: o cf_clearance é atrelado ao fingerprint TLS de quem resolveu, então
# reaproveitar cookie de browser no cliente HTTP nem sempre passa no /api.
CURSODEV_HEADLESS=false
CURSODEV_PROXY=
# Exporte os cookies do browser (Netscape ou "nome=valor; nome2=valor2") e
# aponte o arquivo aqui para pular o login.
CURSODEV_COOKIE_FILE=

# Login via Playwright (browser automatizado). O SSO Hotmart tem AWS WAF
# que exige JS, por isso usa-se browser real para capturar o Bearer token.
# Requer: `uv run playwright install chromium`
HOTMART_EMAIL=
HOTMART_PASSWORD=
# HOTMART_HEADLESS=false para abrir o browser visivelmente (útil pra debug ou 2FA)
HOTMART_HEADLESS=true
# Alternativa: cole um Bearer já pronto e pule o login automatizado
HOTMART_BEARER=
# Para baixar vídeos DRM Widevine: caminho da pasta (ou arquivo .wvd) com a CDM.
# Também requer `mp4decrypt` (Bento4) e `ffmpeg` no PATH.
HOTMART_CDM_PATH=

# Cookies Netscape exportados do browser (EditThisCookie, Cookie-Editor, etc.)
# A maioria dos cursos Udemy usa DRM Widevine — configure CDM abaixo.
UDEMY_CDM_PATH=
# Se UDEMY_CDM_PATH não for definido, usa HOTMART_CDM_PATH como fallback.
# Modo transcrição (opção 2): ordem de preferência de idioma da legenda.
UDEMY_CAPTION_LANG=pt_BR,pt,en

# Aprova Total (app.aprovatotal.com.br)
APROVATOTAL_EMAIL=
APROVATOTAL_PASSWORD=

# Professor Ferretto (app.professorferretto.com.br)
FERRETTO_EMAIL=
FERRETTO_PASSWORD=

# Brasil Paralelo (plataforma.brasilparalelo.com.br)
BRASILPARALELO_EMAIL=
BRASILPARALELO_PASSWORD=
# Widevine CDM para conteúdo protegido (opcional, mesma config do Hotmart)
BRASILPARALELO_CDM_PATH=

# Rocketseat (app.rocketseat.com.br)
# Login via Playwright (Next.js/RSC exige browser real para capturar o Bearer token).
# Requer: `uv run playwright install chromium`
ROCKETSEAT_EMAIL=
ROCKETSEAT_PASSWORD=
# ROCKETSEAT_HEADLESS=false para abrir o browser visivelmente (útil pra debug ou 2FA)
ROCKETSEAT_HEADLESS=true
# Alternativa: cole um Bearer já capturado e pule o login automatizado
# DevTools → Network → XHR → header `authorization`
# ATENÇÃO: sem os cookies do browser a API devolve IDs de vídeo antigos e os
# downloads dão 404. Serve para listar/baixar descrições, não para os vídeos.
ROCKETSEAT_BEARER=
# Pull zone do Bunny Stream de onde as aulas são servidas. Só mexa se os vídeos
# começarem a dar 404: abra uma aula com o DevTools e veja o host do .m3u8.
# ROCKETSEAT_BUNNY_HOST=https://vz-dc851587-83d.b-cdn.net
# Modo "apenas áudio" (perguntado no início do scraper): extensão de saída.
# Só valem formatos aceitos pela transcrição do Groq:
# flac, mp3, mp4, mpeg, mpga, m4a, ogg, wav, webm. Sempre 16 kHz mono.
AUDIO_FORMAT=flac

# Sprache & Wissen (escola.spracheundwissen.com) — LMS ead.guru com ALTCHA (proof-of-work)
# Não requer browser: o captcha é resolvido por SHA-256 puro.
SPRACHE_EMAIL=
SPRACHE_PASSWORD=

# Clube Pula Muralha (clube.pulamuralha.com.br) — LearnWorlds atrás de Cloudflare.
# Usa curl_cffi + impersonate Chrome pra passar do CF WAF.
PULAMURALHA_EMAIL=
PULAMURALHA_PASSWORD=

# Biblioteca Virtual (plataforma.bvirtual.com.br) — login em 2 etapas com instituição.
# Se BVIRTUAL_INSTITUTION_ID não for definido, o scraper mostra a lista pra escolher.
BVIRTUAL_EMAIL=
BVIRTUAL_PASSWORD=
BVIRTUAL_INSTITUTION_ID=
# Threads paralelas para baixar JPGs (default: 8). Aumentar acelera, mas pode
# disparar rate limit do CloudFront — reduza se ver muitos 403/429.
BVIRTUAL_WORKERS=
# PDF compactado: qualidade JPEG (1-95, default 80) e largura máxima em pixels
# (0 desativa o resize, default 1600 ≈ A4 a ~190 dpi).
BVIRTUAL_PDF_QUALITY=
BVIRTUAL_PDF_MAX_WIDTH=

# Universo Narrado (aluno.universonarrado.com.br)
UNIVERSONARRADO_EMAIL=
UNIVERSONARRADO_PASSWORD=

# Qualidade máxima de vídeo (altura em pixels) para os downloads via yt-dlp.
# Vale para as plataformas que já usam o helper format_args (hoje: Kiwify,
# default 720). Use 0 para não limitar e pegar a melhor qualidade disponível.
VIDEO_MAX_HEIGHT=720

# Univirtus / Uninter (univirtus.uninter.com)
UNINTER_LOGIN=
UNINTER_PASSWORD=

# Globoplay (globoplay.globo.com) — SSO GloboID (OpenID Connect + PKCE).
# O login por senha usa hCaptcha invisível resolvido pelo Capsolver quando o
# servidor exige (defina CAPSOLVER_API_KEY). O cookie GLBID do SSO autoriza o
# playback premium.
# Caminho para um arquivo de cookies (formato Netscape) exportado já logado no
# Globoplay (ex.: extensão Cookie-Editor). É o método RECOMENDADO — dispensa
# captcha. Basta conter o cookie GLBID (.globo.com).
GLOBOPLAY_COOKIES=
GLOBOPLAY_EMAIL=
GLOBOPLAY_PASSWORD=
# Opcional: renova o access token sem novo captcha (não semeia GLBID, então o
# playback premium ainda exige login por senha).
GLOBOPLAY_REFRESH_TOKEN=
# Conteúdo premium é DASH com Widevine DRM. Para decifrar, informe o caminho de
# um dispositivo Widevine (.wvd) + tenha pywidevine, mp4decrypt (Bento4) e ffmpeg.
# Sem isso, só trailers/excertos e catálogo aberto baixam.
GLOBOPLAY_WVD=
# Opcional: deviceId enviado ao license server (default: UUID aleatório).
GLOBOPLAY_DEVICE_ID=
# Opcional: sobrepõe a versão do cliente enviada ao GraphQL do catálogo.
GLOBOPLAY_CLIENT_VERSION=

# Crunchyroll (www.crunchyroll.com) — login por cookies (etp_rt). O playback é
# amarrado à sessão web, então use cookies (Cookie-Editor, já logado); salve
# como o arquivo "crunchyroll" na pasta do projeto ou aponte CRUNCHYROLL_COOKIES.
CRUNCHYROLL_COOKIES=
# Decifra Widevine com um .wvd (reaproveita GLOBOPLAY_WVD se não definir este).
CRUNCHYROLL_WVD=
# Baixar TODAS as dublagens (1) ou só o áudio da versão (0). Default: 1.
CRUNCHYROLL_ALL_AUDIOS=

# Prime Video (www.primevideo.com) — usa NAVEGADOR HEADLESS (Playwright/patchright)
# porque o playback é defendido no edge do CloudFront. Login por cookies da Amazon
# (Cookie-Editor logado; essencial o at-main-av). Salve como "primevideo" no projeto.
PRIMEVIDEO_COOKIES=
# Marketplace (default ART4WZ8MWBX2Y = Brasil).
PRIMEVIDEO_MARKETPLACE=

# Paramount+ (www.paramountplus.com) — login por cookies (CBS_COM). Usa curl_cffi
# (impersonate) pra passar do PerimeterX. Salve como "paramountplus" na pasta.
PARAMOUNTPLUS_COOKIES=
# Widevine (Irdeto): precisa de um .wvd NÃO revogado (o Irdeto bloqueia L3 vazados).
# Reaproveita GLOBOPLAY_WVD se não definir. Com CDM válido entrega até 1440p.
PARAMOUNTPLUS_WVD=

# SBT+ (mais.sbt.com.br) — conteúdo GRÁTIS (com anúncio), SEM login. É Brightcove
# + DRMtoday (Widevine L3 comum). Só precisa de um .wvd p/ decifrar (reaproveita
# GLOBOPLAY_WVD se não definir). Precisa de yt-dlp, mp4decrypt (Bento4) e ffmpeg.
SBTPLUS_WVD=

# Prof. Kenny (app.profkenny.com.br) — login por email/senha (Firebase).
# Opcional: cole o idToken do Firebase se preferir não usar email/senha.
PROFKENNY_EMAIL=
PROFKENNY_PASSWORD=
PROFKENNY_IDTOKEN=

# Programa Japonês Online (portal.programajaponesonline.com.br) — WordPress com
# o plugin Membership 2: login por email/senha no wp-login.php. Alternativa (e
# mais estável): exportar os cookies do navegador logado no formato Netscape
# para o arquivo "programajaponesonline" na pasta do projeto.
PJO_EMAIL=
PJO_PASSWORD=
# Caminho de um cookies.txt alternativo (default: ./programajaponesonline).
PJO_COOKIES=

# Nihongo no Mori (nihongonomori.com) — login por email/senha (POST /api/auth/login,
# Bearer). Vídeo é HLS AES-128 com a chave AES pública, então o yt-dlp decifra
# sozinho (não precisa de .wvd). Alternativa: cole o Bearer de uma req autenticada.
NNM_EMAIL=
NNM_PASSWORD=
NNM_BEARER=

# Alura (cursos.alura.com.br) — login por email/senha
ALURA_EMAIL=
ALURA_PASSWORD=

# Traverse (traverse.link) — app Firebase (Auth + Firestore, projeto alley-d0944).
# Login por email/senha; ou cole um refreshToken/idToken do DevTools se preferir.
# Baixa os decks da conta (flashcards, campos, notas e imagens) em downloads/Traverse.
TRAVERSE_EMAIL=
TRAVERSE_PASSWORD=
TRAVERSE_REFRESH_TOKEN=
TRAVERSE_ID_TOKEN=
# Inclui suas respostas/notas pessoais de cada card (1 req a mais por card). Padrão: 1
TRAVERSE_INCLUDE_PERSONAL=1
# TRAVERSE_FORCE=1  → rebaixa decks já salvos

# Mandarin Blueprint (courses.mandarinblueprint.com) — site Kajabi, login email/senha.
# Vídeo é Wistia (yt-dlp baixa, sem DRM). Baixa em downloads/Mandarin Blueprint.
MB_EMAIL=
MB_PASSWORD=

# Rakuten Viki (www.viki.com) — o playback (manifesto DASH + URLs de licença
# Widevine) vem ASSINADO dentro do __NEXT_DATA__ da página /videos/<id>, então
# não há segredo de cliente para configurar. Cookies são OPCIONAIS: catálogo e
# títulos livres respondem anônimos; use-os para títulos de Viki Pass. Exporte
# com o Cookie-Editor já logado e salve como "viki" na pasta do projeto.
VIKI_COOKIES=
# Alternativa aos cookies: login por e-mail/senha. O sign-in do Viki é protegido
# por reCAPTCHA Enterprise, então isto EXIGE CAPSOLVER_API_KEY (score-based pode
# falhar e cair para anônimo). Cookies continuam sendo o caminho mais estável.
VIKI_EMAIL=
VIKI_PASSWORD=
# Decifra Widevine com um .wvd (cai para GLOBOPLAY_WVD e depois cdm/license.wvd).
VIKI_WVD=
# Resolução: quem decide é o PLANO da conta, não o .wvd. Conta grátis recebe o
# manifesto "sd" (topo 480p); assinante Viki Pass recebe "hd", que traz até
# 1080p (medido, avc1, sem gate de DRM no L3). Logado com Pass, suba/zere o
# VIDEO_MAX_HEIGHT acima (vem 720) para não capar o 1080p antes do manifesto.
# Opcional: device id enviado à API do site (default: aleatório por execução).
VIKI_DEVICE_ID=

# Minha Biblioteca (integrada.minhabiblioteca.com.br) — é um VitalSource
# Bookshelf de marca brasileira. O acesso é por SSO da instituição (a conta nem
# tem senha própria), então o login é SÓ POR COOKIES: exporte com o
# Cookie-Editor já logado, INCLUINDO os HttpOnly (o `_aloha_universal` é o que
# autentica, e ele vence em poucas horas), e salve como o arquivo
# "minhabiblioteca" na pasta do projeto ou aponte aqui.
MINHABIBLIOTECA_COOKIES=
# Outra marca VitalSource (o host sai do próprio cookie; isto é só fallback).
MINHABIBLIOTECA_HOST=
# Pausa entre páginas, em segundos. O jigsaw responde 429 se apressar e 428
# (reCAPTCHA) se insistir — não zere sem necessidade. Default: 0.4.
MINHABIBLIOTECA_DELAY=
# Quantos títulos listar por busca no catálogo. Default: 24.
MINHABIBLIOTECA_PAGE_SIZE=

# TheMembers (área de membros white-label *.themembers.com.br)
THEMEMBERS_URL=
THEMEMBERS_EMAIL=
THEMEMBERS_PASSWORD=

# Thinkific (qualquer escola nesse SaaS — ex.: curso.onigirinihongo.com).
# Duas formas de autenticar:
#   1. THINKIFIC_SESSION — cole o cookie ``_thinkific_session`` da aba logada.
#      Pula captcha. Para pegar: F12 → Application → Cookies → _thinkific_session.
#      Aceita o valor cru, ``_thinkific_session=xxx``, ou um bloco multi-cookie.
#   2. Email+senha — precisa de CAPSOLVER_API_KEY (reCAPTCHA v2 invisível).
THINKIFIC_URL=
THINKIFIC_SESSION=
THINKIFIC_EMAIL=
THINKIFIC_PASSWORD=

# greenn.club (área de membros multi-tenant *.greenn.club).
# Duas formas de autenticar:
#   1. GREENN_TOKEN — cole o cookie ``auth_greennCourse`` (ou o valor do
#      header ``Authorization``) da aba já logada no navegador. Pula captcha.
#      Para pegar: F12 → Application → Cookies → auth_greennCourse → copiar
#      value, OU Network → qualquer XHR pra api.greenn.club → header
#      Authorization. Aceita URL-encoded (``%3D``) ou cru.
#   2. Email+senha — precisa de CAPSOLVER_API_KEY para resolver o reCAPTCHA.
GREENN_URL=
GREENN_TOKEN=
GREENN_EMAIL=
GREENN_PASSWORD=

# AntiCaptcha — fallback do CapSolver para AWS WAF (Hotmart).
# Se CAPSOLVER_API_KEY estiver vazia, usa esta como solver.
ANTICAPTCHA_API_KEY=

# Groq Whisper — chaves free (20 RPM / 2000 RPD por chave).
# Lista separada por vírgula. O rodízio é automático; no 429 por minuto
# espera dentro da chamada, no 429 diário pula a chave.
GROQ_API_KEYS=gsk_xxx,gsk_yyy

# Opcional: habilita transcrição Groq ao baixar aulas do Sprache&Wissen (1/true).
# Default: desligado — scraping normal sem transcrever.
SPRACHE_TRANSCRIBE=
